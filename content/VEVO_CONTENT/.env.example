# VEVO_CONTENT local environment example
# Copy to a local .env outside Git-tracked secrets handling if automation needs credentials.

BIZNISWEB_PUBLIC_BASE_URL=https://www.vevo.sk
BIZNISWEB_ADMIN_BASE_URL=https://vevo.flox.sk
BIZNISWEB_NEWS_BLOCK_ID=765
BIZNISWEB_USERNAME=
BIZNISWEB_PASSWORD=

# Optional: used by the extended read-only API smoke, not by article writes.
BIZNISWEB_API_URL=
BIZNISWEB_API_TOKEN=
