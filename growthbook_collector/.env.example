# Required deployment identity and isolated event storage.
AWS_REGION=eu-central-1
GROWTHBOOK_EVENT_BUCKET=
GROWTHBOOK_EVENT_PREFIX=experiment-events/raw

# Fail-safe default: production registry is empty until a reviewed rollout commit.
GROWTHBOOK_ENVIRONMENT=production
GROWTHBOOK_ALLOWED_ORIGINS=https://www.vevo.sk
GROWTHBOOK_EXPERIMENT_REGISTRY_PATH=/var/task/experiments.json

# Bounded ingestion and immutable build identity.
GROWTHBOOK_MAX_BODY_BYTES=4096
GROWTHBOOK_COLLECTOR_VERSION=

# Optional dedicated KMS key. Bucket encryption otherwise uses AES-256.
GROWTHBOOK_EVENT_KMS_KEY_ARN=
